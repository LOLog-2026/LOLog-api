# 로컬 개발용 환경 변수. 이 파일을 .env로 복사한 뒤 값을 채운다. (cp .env.example .env)
# .env는 커밋하지 않는다.
POSTGRES_PASSWORD=change-me
# 앱의 local.properties에 있는 LOLOG_TEST_TOKEN과 같은 값을 넣는다.
LOLOG_TEST_TOKEN=change-me
# /internal 주소의 X-Internal-Token 값. 워커·인증 서비스와 같은 값을 넣는다.
INTERNAL_TOKEN=change-me
# 로컬 SeaweedFS(compose.yaml)의 S3 접근 키. 아무 값이나 넣으면 compose가 그 값으로 SeaweedFS를 띄운다.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
