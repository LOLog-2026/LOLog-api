# 로컬 개발용 환경 변수. 이 파일을 .env로 복사한 뒤 값을 채운다. (cp .env.example .env)
# .env는 커밋하지 않는다.
POSTGRES_PASSWORD=change-me
# 액세스 토큰(JWT) 서명 비밀값. 32바이트 이상. lolog-auth를 함께 띄울 때는 그쪽과 같은 값을 넣는다.
# 인증 서비스 없이 시험할 때는 scripts/dev-token.sh로 이 값으로 서명한 토큰을 만든다.
JWT_SECRET=change-me-to-at-least-32-bytes-long-value
# /internal 주소의 X-Internal-Token 값. 워커·인증 서비스와 같은 값을 넣는다.
INTERNAL_TOKEN=change-me
# 로컬 SeaweedFS(compose.yaml)의 S3 접근 키. 아무 값이나 넣으면 compose가 그 값으로 SeaweedFS를 띄운다.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
